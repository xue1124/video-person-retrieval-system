[Unit]
Description=Video person retrieval API
After=network.target

[Service]
Type=simple
User=videoapp
WorkingDirectory=/opt/osnet-siglip
EnvironmentFile=/opt/osnet-siglip/deploy/env/siglip.env
ExecStart=/opt/osnet-siglip/.venv/bin/python -m uvicorn api_server:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

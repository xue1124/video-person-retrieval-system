# Copy to siglip.env. Do not wrap values in quotes: database.py uses a simple KEY=VALUE parser.
# Use a NEW development database. The database name is fixed by database.py.
TRACKING_DB_URL=mysql+pymysql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/medical_audit_v3?charset=utf8mb4
JWT_SECRET=CHANGE_ME_GENERATE_A_PRIVATE_RANDOM_SECRET
JWT_EXPIRE_MINUTES=1440
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5174

# Run API and worker with the repository root as working directory.
TRACKING_V3_ENABLED=1
TRACKING_V3_YOLO_MODEL=models/pytorch/yolo11m.pt
TRACKING_V3_OSNET_MODEL=models/onnx/osnet_ain_msmt17_dynamic.onnx
OSNET_ONNX=models/onnx/osnet_ain_msmt17_dynamic.onnx
LIVE_YOLO_MODEL=models/pytorch/yolov10n.pt
TRACKING_V3_OSNET_NATIVE_TRT=0
TRACKING_V3_OSNET_TRT=0
TRACKING_V3_IMGSZ=640
TRACKING_V3_CONF=0.60
TRACKING_V3_CROP_BATCH_SIZE=32
TRACKING_V3_GLOBAL_MATCH_THRESH=0.70
TRACKING_V3_CROSS_MATCH=1
TRACKING_V3_COMPUTE_STAYS=1
TRACKING_V3_GENERATE_SNAPSHOTS=1
SIGLIP_TOKENIZER_PATH=models/tokenizer/siglip_v1
SIGLIP_VISION_ONNX=models/onnx/siglip_vision.onnx
SIGLIP_TEXT_ONNX=models/onnx/siglip_text.onnx
VIDEO_PLAYBACK_FINALIZE=0

# Optional reports. Leave empty to keep Dify unconfigured.
DIFY_BASE_URL=
DIFY_WORKFLOW_API_KEY=
DIFY_REPORT_TIMEOUT_SECONDS=120

# NVR adapters require separately deployed proxy/relay services.
ISAPI_PROXY_BASE=http://127.0.0.1:8080
RTSP_RELAY_CTRL=http://127.0.0.1:18090
RTSP_RELAY_PLAY_URL=rtsp://127.0.0.1:18554/relay
